# ---------------------------------------------------------------------------
# Channex connectivity
# ---------------------------------------------------------------------------
# User API key from the Channex dashboard (Settings -> API keys).
# Without it STAYBASE runs in dry-run mode: every push reports exactly what
# would be sent but nothing leaves the app.
CHANNEX_API_KEY=

# Sandbox:    https://staging.channex.io/api/v1
# Production: https://app.channex.io/api/v1
CHANNEX_BASE_URL=https://staging.channex.io/api/v1

# Shared secret used to verify the HMAC-SHA256 signature on inbound webhooks.
# Leave empty only in the sandbox — an unsigned webhook endpoint is public.
CHANNEX_WEBHOOK_SECRET=

# Abort a Channex request after this many milliseconds.
CHANNEX_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# Postgres connection string (Neon, Supabase, RDS...). When unset the app
# serves the bundled demo dataset so preview deploys work with no infra.
DATABASE_URL=
